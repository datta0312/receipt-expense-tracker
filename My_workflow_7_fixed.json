        "jsonBody": "={{ JSON.stringify({\n  model: 'meta-llama/llama-4-scout-17b-16e-instruct',\n  messages: [{ role: 'user', content: [\n    { type: 'text', text: 'You are reading a receipt image. Extract: vendor (store/merchant name), date (format YYYY-MM-DD, the date printed on the receipt), total_amount (final grand total paid, as a number only), currency (3-letter code like INR, USD), category (one of: Food, Groceries, Travel, Shopping, Utilities, Health, Entertainment, Other). Return ONLY valid JSON: {\"vendor\":\"\",\"date\":\"\",\"total_amount\":0,\"currency\":\"\",\"category\":\"\"}. Use null if a value is not visible. Do NOT guess or use todays date.' },\n    { type: 'image_url', image_url: { url: 'data:' + $json.mimeType + ';base64,' + $json.base64 } }\n  ] }],\n  response_format: { type: 'json_object' },\n  temperature: 0\n}) }}",
