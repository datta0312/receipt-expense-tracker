      "parameters": {
        "jsCode": "let content = $json.choices[0].message.content;\nif (typeof content === 'string') content = content.replace(/```json|```/g,'').trim();\nconst r = typeof content === 'string' ? JSON.parse(content) : content;\nreturn [{ json: {\n  Vendor: r.vendor ?? '',\n  Date: r.date ?? '',\n  'Total Amount': r.total_amount ?? '',\n  Currency: r.currency ?? '',\n  Category: r.category ?? ''\n} }];"
