        "jsCode": "const item = $input.first();\n\nconst binaryData = await this.helpers.getBinaryDataBuffer(\n  0,\n  'Upload_Receipt'\n);\n\nconst base64 = binaryData.toString('base64');\n\nreturn [\n  {\n    json: {\n      mimeType: item.binary.Upload_Receipt.mimeType,\n      fileName: item.binary.Upload_Receipt.fileName,\n      base64: base64\n    }\n  }\n];"
      },
